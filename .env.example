# Copy to .env. Configure at least one Box app; the UI offers whichever are
# configured, and uses the first one listed here that is.

# Box MCP integration — signs in a user, then calls Box's MCP server
BOX_MCP_CLIENT_ID=
BOX_MCP_CLIENT_SECRET=

# Platform OAuth app — signs in a user, then calls the Box REST API
BOX_OAUTH_CLIENT_ID=
BOX_OAUTH_CLIENT_SECRET=

# Platform CCG app — a service account, no sign-in, needs admin authorization
BOX_CCG_CLIENT_ID=
BOX_CCG_CLIENT_SECRET=
BOX_CCG_ENTERPRISE_ID=
# BOX_CCG_USER_ID=            set instead of the enterprise id to act as one user

# In each app that signs in a user, register:
#   Redirect URI  http://127.0.0.1:3000/api/auth/callback
#   CORS origin   http://127.0.0.1:3000

# Uploads land in the account's root folder. Set these to confine them.
# BOX_USER_ROOT_FOLDER_ID=
# BOX_CCG_ROOT_FOLDER_ID=

# Only if you serve the app somewhere other than http://127.0.0.1:3000 — it
# must match the redirect URI and CORS origin registered above.
# APP_ORIGIN=
