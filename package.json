{
  "name": "box-mcp-upload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "mcp": "tsx src/mcp/server.ts",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "e2e:live": "tsx scripts/e2e.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts README.md docs/*.md *.ts package.json",
    "format:check": "prettier --check src tests scripts README.md docs/*.md *.ts package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.4",
    "hash-wasm": "^4.12.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
